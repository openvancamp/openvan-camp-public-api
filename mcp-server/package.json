{
  "name": "@openvancamp/mcp-server",
  "version": "0.8.0",
  "mcpName": "io.github.Kopaev/openvan-travel",
  "description": "Official MCP server for OpenVan.camp — free vanlife/RV travel data with interactive cards in Claude and ChatGPT: whole-trip roadbooks, fuel prices, toll roads, holidays and peak traffic, travel hazards, power plugs, customs rules, visas, events, weather by country and city, food index, currency, news, license plates of the world. No auth, CC BY 4.0.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-server": "dist/index.js",
    "openvan-mcp": "dist/index.js",
    "openvan-mcp-sse": "dist/sse.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "engine",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "sync-engine": "node scripts/sync-engine.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic",
    "chatgpt",
    "cursor",
    "vanlife",
    "rv",
    "motorhome",
    "fuel-prices",
    "travel",
    "openvan",
    "roadbook",
    "road-trip",
    "mcp-apps"
  ],
  "homepage": "https://openvan.camp/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openvancamp/openvan-camp-public-api.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "mailto:hello@openvan.camp"
  },
  "author": "OpenVan.camp <hello@openvan.camp>",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
